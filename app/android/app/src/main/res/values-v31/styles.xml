<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) draws its own splash screen and ignores windowBackground for
         it; its background defaults to the theme colour (white in light mode). Pin it to the
         Foundation ground so no white frame shows (F05 architecture §18.3 (8)). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/loop_ground</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
