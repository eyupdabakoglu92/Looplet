rules_version = '2';

// LOOPLET Firestore security rules.
//
// MVP surface (platform.md §6, f08 architecture.md → Firebase Sync Surface → Rules):
//   dailyResults/{lang}_{date}/entries/{uid}
//     - no client access at all: create, update, delete and read are denied.
//     - the only writer is the `submitDailyResultV1` callable, through the Admin
//       SDK, which security rules do not apply to. It validates the payload,
//       derives the path from `context.auth.uid`, and enforces create-only /
//       first-writer-wins inside its transaction (an existing entry →
//       ALREADY_SUBMITTED).
//     - a client create would skip that validation, so it is denied too
//       (f08 architecture.md A9). A future leaderboard adds scoped reads.
// Everything else is denied by default.

service cloud.firestore {
  match /databases/{database}/documents {

    match /dailyResults/{bucket}/entries/{uid} {
      allow create, update, delete, read: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
