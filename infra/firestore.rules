rules_version = '2';

// LOOPLET Firestore security rules.
//
// MVP surface (platform.md §6, f08 architecture.md → Firebase Sync Surface):
//   dailyResults/{lang}_{date}/entries/{uid}
//     - create : only the signed-in user, only their own uid slot.
//               `create` fires only when the doc does not exist, so this is
//               inherently first-write-wins / create-only.
//     - update / delete / read : denied for everyone in the MVP (no leaderboard,
//               no cross-user reads). A future leaderboard adds scoped reads.
// Everything else is denied by default.

service cloud.firestore {
  match /databases/{database}/documents {

    match /dailyResults/{bucket}/entries/{uid} {
      allow create: if request.auth != null
                    && request.auth.uid == uid;
      allow update, delete, read: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
