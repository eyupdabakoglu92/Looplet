{
  "name": "looplet-functions",
  "version": "0.1.0",
  "description": "LOOPLET Cloud Functions — offline daily-result sync (submitDailyResultV1).",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:emulator": "firebase --config ../firebase.json emulators:exec --only firestore,auth --project demo-looplet \"jest --passWithNoTests\"",
    "serve": "npm run build && firebase --config ../firebase.json emulators:start --only functions,firestore",
    "deploy": "firebase --config ../firebase.json deploy --only functions,firestore:rules"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.20.4",
    "firebase": "^12.0.0",
    "firebase-functions-test": "^3.4.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.0"
  }
}
